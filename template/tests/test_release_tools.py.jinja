    """Create an independent repository and a local bare remote."""
    monkeypatch.setenv("GIT_CONFIG_NOSYSTEM", "1")
    monkeypatch.setenv("GIT_CONFIG_GLOBAL", str(tmp_path / "no-global-config"))
    project = tmp_path / "project"
    project.mkdir()
    release.git(project, "init", "-q", "--initial-branch={{ integration_branch }}")
    release.git(project, "config", "user.name", "Release Test")
    release.git(project, "config", "user.email", "release@example.invalid")
    (project / "uv.lock").write_text("lock\n")
