`{{ 'uv run noxfile.py' if package_manager == 'uv' else ('mamba run --name ' ~ mamba_environment_name ~ ' nox' if package_manager == 'mamba' else 'pixi run --locked nox') }} -s tests-{{ minimum_python }} -- tests/` for a focused Nox run.
