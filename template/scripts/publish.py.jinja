"""Verify release tags and explicitly dispatch package publishing."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import time
import uuid
from pathlib import Path

from scripts.distributions import release_version
from scripts.release import git


def resolve(directory: Path, tag: str) -> tuple[str, bool]:
    """Verify that the remote annotated tag points to main history."""
    version = release_version(tag)
    ref = f"refs/tags/{tag}"
    if git(directory, "cat-file", "-t", ref) != "tag":
        raise ValueError("Release tag must be annotated")
    header = git(directory, "cat-file", "-p", ref).partition("\n\n")[0]
    if "type commit" not in header.splitlines():
        raise ValueError("Release tag must point directly to a commit")
    remote_tag = git(directory, "ls-remote", "--exit-code", "origin", ref).split()[0]
    if remote_tag != git(directory, "rev-parse", ref):
        raise ValueError("Remote tag differs from the local tag")
    commit = git(directory, "rev-parse", ref + "^{commit}")
    remote_main = git(
        directory, "ls-remote", "--exit-code", "origin", "refs/heads/main"
    ).split()[0]
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", commit, remote_main], cwd=directory
    )
    if result.returncode:
        raise ValueError("Tag is not on remote main history; fetch and verify it")
    return commit, version.is_prerelease


def notes(directory: Path, tag: str) -> str:
    """Read final release notes, or preview pending notes for a candidate."""
    version = release_version(tag)
    if version.is_prerelease:
        return subprocess.check_output(
            [
                "uv",
                "run",
                "--locked",
                "--group",
                "release",
                "towncrier",
                "build",
                "--version",
                str(version),
                "--draft",
            ],
            cwd=directory,
            text=True,
        )
    changelog = git(directory, "show", f"refs/tags/{tag}:CHANGELOG.md")
    lines = changelog.splitlines()
    heading = f"## [{version}]"
    for index, line in enumerate(lines):
        if line.startswith(heading):
            end = next(
                (i for i in range(index + 1, len(lines)) if lines[i].startswith("## ")),
                len(lines),
            )
            return "\n".join(lines[index:end]).strip() + "\n"
    raise ValueError(f"No changelog section for {version}")


def gh_json(*args: str) -> object:
    """Read a JSON result from GitHub CLI."""
    return json.loads(subprocess.check_output(["gh", *args], text=True))


def dispatch(tag: str) -> None:
    """Dispatch one publication and wait for that exact workflow run."""
    resolve(Path.cwd(), tag)
    request = uuid.uuid4().hex
    title = f"Publish {tag} [{request}]"
    subprocess.run(
        [
            "gh",
            "workflow",
            "run",
            "release.yaml",
            "--ref",
            "main",
            "-f",
            f"tag={tag}",
            "-f",
            f"request_id={request}",
        ],
        check=True,
    )
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        runs = gh_json(
            "run",
            "list",
            "--workflow",
            "release.yaml",
            "--event",
            "workflow_dispatch",
            "--limit",
            "100",
            "--json",
            "databaseId,displayTitle,url",
        )
        if not isinstance(runs, list):
            raise ValueError("Unexpected GitHub Actions response")
        for run in runs:
            if run["displayTitle"] == title:
                print(run["url"], flush=True)
                subprocess.run(
                    ["gh", "run", "watch", str(run["databaseId"]), "--exit-status"],
                    check=True,
                )
                return
        time.sleep(2)
    raise RuntimeError(
        f"Workflow not observed; inspect Actions for {title} before retrying"
    )


def main() -> None:
    """Publish a tag or resolve it for the release workflow."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("tag", nargs="?", default=os.environ.get("TAG"))
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--resolve", action="store_true")
    mode.add_argument("--notes-file", type=Path)
    args = parser.parse_args()
    if not args.tag:
        parser.error("Provide a tag or set TAG")
    directory = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
    if args.resolve:
        commit, prerelease = resolve(directory, args.tag)
        result = (
            f"commit={commit}\ntag={args.tag}\n"
            f"index={'testpypi' if prerelease else 'pypi'}\n"
            f"prerelease={str(prerelease).lower()}\n"
        )
        if output := os.environ.get("GITHUB_OUTPUT"):
            with Path(output).open("a") as stream:
                stream.write(result)
        print(result, end="")
    elif args.notes_file:
        commit = git(directory, "rev-parse", f"refs/tags/{args.tag}" + "^{commit}")
        if git(directory, "rev-parse", "HEAD") != commit:
            raise ValueError("Release notes must be generated at the tagged commit")
        args.notes_file.write_text(notes(directory, args.tag))
    else:
        dispatch(args.tag)


if __name__ == "__main__":
    main()
