"""Run source checks followed by build and distribution validation."""

from __future__ import annotations

import subprocess
{% if not require_typecheck %}import sys
{% endif %}


def tracked_changes() -> tuple[bytes, bytes]:
    """Return the current unstaged and staged tracked changes."""
    return (
        subprocess.check_output(["git", "diff", "--binary"]),
        subprocess.check_output(["git", "diff", "--cached", "--binary"]),
    )


def main() -> None:
    """Run checks in order and reject changes made by formatters."""
    before = tracked_changes()
    for target in (
        "lint",
        "test",
        "typecheck",
{%- if docs %}
        "docs",
{%- endif %}
        "build",
        "check-dist",
    ):
{% if not require_typecheck %}        try:
            subprocess.run(["make", target], check=True)
        except subprocess.CalledProcessError:
            if target != "typecheck":
                raise
            print("Type checking failed (not required); continuing.", file=sys.stderr)
{% else %}        subprocess.run(["make", target], check=True)
{% endif %}        if tracked_changes() != before:
            raise RuntimeError(
                f"{target} modified tracked files; review and rerun checks"
            )


if __name__ == "__main__":
    main()
