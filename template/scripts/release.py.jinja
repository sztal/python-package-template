"""Prepare a validated local release without pushing or publishing."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path
from tempfile import mkdtemp

from packaging.version import InvalidVersion, Version

from scripts.distributions import release_version

INTEGRATION_BRANCH = "{{ integration_branch }}"

{%- if package_manager == 'mamba' %}


def mamba_run(prefix: Path | None = None) -> list[str]:
    """Run a command in the selected or explicitly supplied Mamba environment."""
    location = (
        str(prefix) if prefix is not None else os.environ.get("MAMBA_PROJECT_PREFIX")
    )
    if location:
        return ["mamba", "run", "--prefix", location]
    return ["mamba", "run", "--name", "{{ mamba_environment_name }}"]


def prepare_environment(directory: Path, prefix: Path) -> None:
    """Install the cloned project into an independent Mamba environment."""
    subprocess.run(
        [
            "mamba",
            "create",
            "--yes",
            "--prefix",
            str(prefix),
            "--file",
            "environment.yaml",
        ],
        cwd=directory,
        check=True,
    )
    subprocess.run(
        [
            *mamba_run(prefix),
            "python",
            "-m",
            "pip",
            "install",
            "--editable",
            ".",
            "--group",
            "dev",
{%- if docs %}
            "--group",
            "docs",
{%- endif %}
        ],
        cwd=directory,
        check=True,
    )


def refresh_project(directory: Path, prefix: Path) -> None:
    """Refresh installed metadata after the release tag is created."""
    subprocess.run(
        [
            *mamba_run(prefix),
            "python",
            "-m",
            "pip",
            "install",
            "--no-deps",
            "--editable",
            ".",
        ],
        cwd=directory,
        check=True,
    )


def remove_environment(prefix: Path) -> None:
    """Remove the temporary release environment."""
    subprocess.run(
        ["mamba", "env", "remove", "--yes", "--prefix", str(prefix)], check=True
    )

{%- endif %}


def git(directory: Path, *args: str) -> str:
    """Run Git and return its output."""
    return subprocess.check_output(["git", *args], cwd=directory, text=True).strip()


def clean(directory: Path) -> None:
    """Require a clean index and working tree, including untracked files."""
    if git(directory, "status", "--porcelain", "--untracked-files=all"):
        raise RuntimeError("Release preparation requires a clean working tree")


def state(directory: Path) -> tuple[str, str | None]:
    """Check the integration branch and any configured origin."""
    clean(directory)
    if git(directory, "symbolic-ref", "--short", "HEAD") != INTEGRATION_BRANCH:
        raise RuntimeError(
            f"Release preparation requires the {INTEGRATION_BRANCH} branch"
        )
    head = git(directory, "rev-parse", "HEAD")
    remote = None
    if "origin" in git(directory, "remote").splitlines():
        remote = git(
            directory,
            "ls-remote",
            "--exit-code",
            "origin",
            f"refs/heads/{INTEGRATION_BRANCH}",
        ).split()[0]
        result = subprocess.run(
            ["git", "merge-base", "--is-ancestor", remote, head],
            check=False,
            cwd=directory,
        )
        if result.returncode:
            raise RuntimeError(
                f"Local {INTEGRATION_BRANCH} does not contain origin/{INTEGRATION_BRANCH}; "
                "fetch and reconcile it"
            )
    git(directory, "ls-files", "--error-unmatch", "{{ 'environment.yaml' if package_manager == 'mamba' else package_manager ~ '.lock' }}")
    return head, remote


def check_available(directory: Path, tag: str) -> None:
    """Reject existing tags and versions that do not advance release tags."""
    version = release_version(tag)
    tags = set(git(directory, "tag", "--list").splitlines())
    if "origin" in git(directory, "remote").splitlines():
        for line in git(
            directory, "ls-remote", "--tags", "--refs", "origin"
        ).splitlines():
            tags.add(line.split()[1].removeprefix("refs/tags/"))
    for existing in tags:
        if existing == tag:
            raise ValueError(f"Release tag already exists: {tag}")
        try:
            previous = Version(existing.removeprefix("v"))
        except InvalidVersion:
            continue
        if previous >= version:
            raise ValueError(f"Release must be newer than {existing}")
{% if changelog %}

def notes(directory: Path, version: str{% if package_manager == 'mamba' %}, prefix: Path | None = None{% endif %}) -> None:
    """Preview Towncrier notes without changing files."""
    subprocess.run(
        [
{%- if package_manager == 'mamba' %}
            *mamba_run(prefix),
{%- else %}
            "{{ package_manager }}",
            "run",
            "--locked",
{%- if package_manager == 'uv' %}
            "--group",
            "release",
{%- endif %}
{%- endif %}
            "towncrier",
            "build",
            "--version",
            version,
            "--draft",
        ],
        cwd=directory,
        check=True,
    )
{% endif %}

def validate(directory: Path, tag: str{% if package_manager == 'mamba' %}, prefix: Path{% endif %}) -> None:
    """Run all checks against the tagged checkout."""
    env = os.environ.copy()
    env["TAG"] = tag
{%- if package_manager == 'mamba' %}
    env["MAMBA_PROJECT_PREFIX"] = str(prefix)
{%- endif %}
    subprocess.run(["make", "check"], cwd=directory, env=env, check=True)


def prepare(directory: Path, version: str, *, dry_run: bool) -> None:
    """Validate a release in an isolated clone and optionally install it locally."""
    tag = f"v{version}"
    release_version(tag)
    head, remote = state(directory)
    check_available(directory, tag)
    temporary = Path(mkdtemp(prefix="package-release-"))
    checkout = temporary / "checkout"
    try:
        subprocess.run(
            [
                "git",
                "clone",
                "--no-hardlinks",
                "--no-checkout",
                str(directory),
                str(checkout),
            ],
            check=True,
        )
        git(checkout, "checkout", "--detach", head)
        for key in ("user.name", "user.email"):
            git(checkout, "config", key, git(directory, "config", "--get", key))
{%- if package_manager == 'mamba' %}
        prefix = temporary / "environment"
        prepare_environment(checkout, prefix)
{%- endif %}
{% if changelog %}
        if release_version(tag).is_prerelease:
            notes(checkout, version{% if package_manager == 'mamba' %}, prefix{% endif %})
        else:
            subprocess.run(
                [
{%- if package_manager == 'mamba' %}
                    *mamba_run(prefix),
{%- else %}
                    "{{ package_manager }}",
                    "run",
                    "--locked",
{%- if package_manager == 'uv' %}
                    "--group",
                    "release",
{%- endif %}
{%- endif %}
                    "towncrier",
                    "build",
                    "--version",
                    version,
                    "--yes",
                ],
                cwd=checkout,
                check=True,
            )
            git(checkout, "add", "--", "CHANGELOG.md", "changelog.d")
            git(checkout, "commit", "-m", f"Prepare release {version}")
{% endif %}
        git(checkout, "tag", "--annotate", tag, "--message", f"Release {version}")
{%- if package_manager == 'mamba' %}
        refresh_project(checkout, prefix)
{%- endif %}
        validate(checkout, tag{% if package_manager == 'mamba' %}, prefix{% endif %})
        clean(checkout)
        if state(directory) != (head, remote):
            raise RuntimeError(
                f"Local or remote {INTEGRATION_BRANCH} changed during validation"
            )
        check_available(directory, tag)
        if not dry_run:
            prepared = git(checkout, "rev-parse", "HEAD")
            git(
                directory,
                "fetch",
                "--no-tags",
                "--no-write-fetch-head",
                str(checkout),
                prepared,
            )
            if state(directory) != (head, remote):
                raise RuntimeError(
                    f"Local or remote {INTEGRATION_BRANCH} changed during validation"
                )
            git(directory, "merge", "--ff-only", prepared)
            git(
                directory,
                "fetch",
                "--no-tags",
                "--no-write-fetch-head",
                str(checkout),
                f"refs/tags/{tag}:refs/tags/{tag}",
            )
    except Exception:
        print(f"Release preparation failed; inspect {checkout}", file=sys.stderr)
        raise
    else:
{%- if package_manager == 'mamba' %}
        remove_environment(prefix)
{%- endif %}
        shutil.rmtree(temporary)
    if dry_run:
        print("Release rehearsal passed; caller files and refs are unchanged")
    else:
        print(f"Prepared {tag} locally; nothing was pushed or published.")
        if remote is not None:
            print(
                f"Push explicitly: git push --atomic origin "
                f"refs/heads/{INTEGRATION_BRANCH}:refs/heads/{INTEGRATION_BRANCH} "
                f"refs/tags/{tag}:refs/tags/{tag}"
            )


def main() -> None:
    """Preview, rehearse, or prepare a release."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", nargs="?", default=os.environ.get("VERSION"))
    mode = parser.add_mutually_exclusive_group()
{% if changelog %}
    mode.add_argument("--notes", action="store_true")
{% endif %}
    mode.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if not args.version:
        parser.error("Provide a version or set VERSION")
    release_version(f"v{args.version}")
    directory = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
{% if changelog %}
    if args.notes:
        notes(directory, args.version)
    else:
        prepare(directory, args.version, dry_run=args.dry_run)
{%- else %}
    prepare(directory, args.version, dry_run=args.dry_run)
{%- endif %}


if __name__ == "__main__":
    main()
