"""Prepare a validated local release without pushing or publishing."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path
from tempfile import mkdtemp

from packaging.version import InvalidVersion, Version

from scripts.distributions import release_version


def git(directory: Path, *args: str) -> str:
    """Run Git and return its output."""
    return subprocess.check_output(["git", *args], cwd=directory, text=True).strip()


def clean(directory: Path) -> None:
    """Require a clean index and working tree, including untracked files."""
    if git(directory, "status", "--porcelain", "--untracked-files=all"):
        raise RuntimeError("Release preparation requires a clean working tree")


def state(directory: Path) -> tuple[str, str]:
    """Check that local main contains the current remote main."""
    clean(directory)
    if git(directory, "symbolic-ref", "--short", "HEAD") != "main":
        raise RuntimeError("Release preparation requires the main branch")
    head = git(directory, "rev-parse", "HEAD")
    remote = git(
        directory, "ls-remote", "--exit-code", "origin", "refs/heads/main"
    ).split()[0]
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", remote, head], check=False, cwd=directory
    )
    if result.returncode:
        raise RuntimeError(
            "Local main does not contain origin/main; fetch and reconcile it"
        )
    git(directory, "ls-files", "--error-unmatch", "uv.lock")
    return head, remote


def check_available(directory: Path, tag: str) -> None:
    """Reject existing tags and versions that do not advance release tags."""
    version = release_version(tag)
    tags = set(git(directory, "tag", "--list").splitlines())
    for line in git(directory, "ls-remote", "--tags", "--refs", "origin").splitlines():
        tags.add(line.split()[1].removeprefix("refs/tags/"))
    for existing in tags:
        if existing == tag:
            raise ValueError(f"Release tag already exists: {tag}")
        try:
            previous = Version(existing.removeprefix("v"))
        except InvalidVersion:
            continue
        if previous >= version:
            raise ValueError(f"Release must be newer than {existing}")


def notes(directory: Path, version: str) -> None:
    """Preview Towncrier notes without changing files."""
    subprocess.run(
        [
            "uv",
            "run",
            "--locked",
            "--group",
            "release",
            "towncrier",
            "build",
            "--version",
            version,
            "--draft",
        ],
        cwd=directory,
        check=True,
    )


def validate(directory: Path, tag: str) -> None:
    """Run all checks against the tagged checkout."""
    env = os.environ.copy()
    env["TAG"] = tag
    subprocess.run(["make", "check"], cwd=directory, env=env, check=True)


def prepare(directory: Path, version: str, *, dry_run: bool) -> None:
    """Validate a release in an isolated clone and optionally install it locally."""
    tag = f"v{version}"
    parsed = release_version(tag)
    head, remote = state(directory)
    check_available(directory, tag)
    temporary = Path(mkdtemp(prefix="package-release-"))
    checkout = temporary / "checkout"
    try:
        subprocess.run(
            [
                "git",
                "clone",
                "--no-hardlinks",
                "--no-checkout",
                str(directory),
                str(checkout),
            ],
            check=True,
        )
        git(checkout, "checkout", "--detach", head)
        for key in ("user.name", "user.email"):
            git(checkout, "config", key, git(directory, "config", "--get", key))
        if parsed.is_prerelease:
            notes(checkout, version)
        else:
            subprocess.run(
                [
                    "uv",
                    "run",
                    "--locked",
                    "--group",
                    "release",
                    "towncrier",
                    "build",
                    "--version",
                    version,
                    "--yes",
                ],
                cwd=checkout,
                check=True,
            )
            git(checkout, "add", "--", "CHANGELOG.md", "changelog.d")
            git(checkout, "commit", "-m", f"Prepare release {version}")
        git(checkout, "tag", "--annotate", tag, "--message", f"Release {version}")
        validate(checkout, tag)
        clean(checkout)
        if state(directory) != (head, remote):
            raise RuntimeError("Local or remote main changed during validation")
        check_available(directory, tag)
        if not dry_run:
            prepared = git(checkout, "rev-parse", "HEAD")
            git(
                directory,
                "fetch",
                "--no-tags",
                "--no-write-fetch-head",
                str(checkout),
                prepared,
            )
            if state(directory) != (head, remote):
                raise RuntimeError("Local or remote main changed during validation")
            git(directory, "merge", "--ff-only", prepared)
            git(
                directory,
                "fetch",
                "--no-tags",
                "--no-write-fetch-head",
                str(checkout),
                f"refs/tags/{tag}:refs/tags/{tag}",
            )
    except Exception:
        print(f"Release preparation failed; inspect {checkout}", file=sys.stderr)
        raise
    else:
        shutil.rmtree(temporary)
    if dry_run:
        print("Release rehearsal passed; caller files and refs are unchanged")
    else:
        print(f"Prepared {tag} locally; nothing was pushed or published.")
        print(
            f"Push explicitly: git push --atomic origin "
            f"refs/heads/main:refs/heads/main refs/tags/{tag}:refs/tags/{tag}"
        )


def main() -> None:
    """Preview, rehearse, or prepare a release."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", nargs="?", default=os.environ.get("VERSION"))
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--notes", action="store_true")
    mode.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if not args.version:
        parser.error("Provide a version or set VERSION")
    release_version(f"v{args.version}")
    directory = Path(git(Path.cwd(), "rev-parse", "--show-toplevel"))
    if args.notes:
        notes(directory, args.version)
    else:
        prepare(directory, args.version, dry_run=args.dry_run)


if __name__ == "__main__":
    main()
