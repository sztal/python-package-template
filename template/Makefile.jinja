.PHONY: help clean build wheel install init test coverage coverage-html lint format typecheck check check-dist release
{% if pypi_publish %}
.PHONY: publish
{% endif %}
{% if changelog %}
.PHONY: release-notes
{% endif %}
{% if tasks == "nox" %}
.PHONY: nox
{% endif %}
{% if docs %}
.PHONY: docs docs-serve
{% endif %}

export VERSION TAG
RUN = {{ 'uv run' if package_manager == 'uv' else 'pixi run --locked' }}

help:
	@echo "Usage: make <target>"
	@echo ""
	@echo "Targets:"
	@echo "  help           Show this help message"
	@echo "  clean          Remove build artifacts and cache files"
	@echo "  build          Build source distribution and wheel"
	@echo "  wheel          Build wheel only"
	@echo "  install        Install the package with development dependencies"
	@echo "  test           Run the pytest suite"
{% if tasks == "nox" %}
	@echo "  nox            Run the supported-Python test matrix"
{% endif %}
	@echo "  coverage       Run tests with a terminal coverage report"
	@echo "  coverage-html  Run tests with an HTML coverage report"
	@echo "  lint           Run pre-commit checks"
	@echo "  format         Format Python files with Ruff"
	@echo "  typecheck      Run mypy"
{% if docs %}
	@echo "  docs           Build documentation strictly"
	@echo "  docs-serve     Preview documentation"
{% endif %}
	@echo "  check          Run source and distribution checks"
	@echo "  check-dist     Validate distributions; optionally set TAG=vX.Y.Z"
{% if changelog %}
	@echo "  release-notes  Preview notes for VERSION=X.Y.Z"
{% endif %}
	@echo "  release        Prepare VERSION locally without publishing"
{% if pypi_publish %}
	@echo "  publish        Explicitly publish TAG"
{% endif %}

init:
	make install
	$(RUN) pre-commit install

clean:
	rm -rf dist/ build/ .nox/ .pytest_cache/ .ruff_cache/ htmlcov/
	find . -name "*.egg-info" -type d -prune -exec rm -rf {} +
	find . -name "__pycache__" -type d -prune -exec rm -rf {} +
	find . -name "*.py[cod]" -delete
	find . -name ".coverage*" -delete

build:
{% if package_manager == 'uv' %}
	uv build --no-sources
{% else %}
	$(RUN) python -m build --sdist --wheel
{% endif %}

wheel:
{% if package_manager == 'uv' %}
	uv build --no-sources --wheel
{% else %}
	$(RUN) python -m build --wheel
{% endif %}

install:
{% if package_manager == 'uv' %}
	uv sync --group dev
{% else %}
	pixi install
{% endif %}

test:
	$(RUN) pytest

{% if tasks == "nox" %}
nox:
	$(RUN) {% if package_manager == 'uv' %}noxfile.py -s tests{% else %}nox --tags tests{% endif %}

{% endif %}

coverage:
	$(RUN) coverage run -m pytest{% if pytest_testmon != 'no' %} --no-testmon{% endif %}
	$(RUN) coverage report

coverage-html:
	$(RUN) coverage run -m pytest{% if pytest_testmon != 'no' %} --no-testmon{% endif %}
	$(RUN) coverage html

lint:
{% if tasks == "nox" %}
	$(RUN) {% if package_manager == 'uv' %}noxfile.py{% else %}nox{% endif %} -s lint
{% else %}
	$(RUN) pre-commit run --all-files
{% endif %}

format:
	$(RUN) ruff format .

typecheck:
{% if tasks == "nox" %}
	$(RUN) {% if package_manager == 'uv' %}noxfile.py{% else %}nox{% endif %} -s typecheck
{% else %}
	$(RUN) mypy {{ package_path }} tests scripts
{% endif %}

{% if docs %}
docs:
{% if tasks == "nox" %}
	$(RUN) {% if package_manager == 'uv' %}noxfile.py{% else %}nox{% endif %} -s docs
{% else %}
	$(RUN) {% if package_manager == 'uv' %}--group docs {% endif %}zensical build --clean --strict
{% endif %}

docs-serve:
{% if tasks == "nox" %}
	$(RUN) {% if package_manager == 'uv' %}noxfile.py{% else %}nox{% endif %} -s autodocs
{% else %}
	$(RUN) {% if package_manager == 'uv' %}--group docs {% endif %}zensical serve --open
{% endif %}
{% endif %}
check:
	$(RUN) {% if package_manager == 'uv' %}--group release {% endif %}python -m scripts.check

check-dist:
	$(RUN) {% if package_manager == 'uv' %}--group release {% endif %}python -m scripts.distributions check

{% if changelog %}
release-notes:
	$(RUN) {% if package_manager == 'uv' %}--group release {% endif %}python -m scripts.release --notes

{% endif %}
release:
	$(RUN) {% if package_manager == 'uv' %}--group release {% endif %}python -m scripts.release
{%- if pypi_publish %}

publish:
	$(RUN) {% if package_manager == 'uv' %}--group release {% endif %}python -m scripts.publish
{%- endif %}
