"""Development checks with Nox."""

from __future__ import annotations

import os
from pathlib import Path

import nox
from scripts.typecheck import mypy_args, mypy_paths

nox.needs_version = ">=2025.2.9"
nox.options.default_venv_backend = "{{ 'uv' if package_manager == 'uv' else 'mamba' }}"
nox.options.reuse_existing_virtualenvs = True
nox.options.sessions = (
    "lint",
    "typecheck",
{%- if docs %}
    "docs",
{%- endif %}
    "tests",
)

PYPROJECT = nox.project.load_toml()
PROJECT_NAME = PYPROJECT["project"]["name"]
SUPPORTED_PYTHON_VERSIONS = nox.project.python_versions(PYPROJECT)
DEFAULT_PYTHON_VERSION = Path(".python-version").read_text().rstrip()
{%- if package_manager == 'mamba' %}
MAMBA_OPTIONS = ["--override-channels", "--channel=conda-forge", "pip>=25.1"]
{%- endif %}


{% if package_manager == 'mamba' -%}
@nox.session(
    python=SUPPORTED_PYTHON_VERSIONS, tags=["tests"], venv_params=MAMBA_OPTIONS
)
{% else -%}
@nox.session(python=SUPPORTED_PYTHON_VERSIONS, tags=["tests"])
{% endif -%}
def tests(session: nox.Session) -> None:
    """Run the test suite."""
{%- if package_manager == 'mamba' or install == 'uv pip' %}
    session.install(".", "--group", "test")
{%- else %}
    uv_sync(
        "--no-editable",
        "--reinstall-package",
        PROJECT_NAME,
        "--group",
        "test",
        session=session,
    )
{%- endif %}
    if session.posargs:
        session.run("pytest", *session.posargs)
        return

    tmp_dir = Path(session.create_tmp())

    if os.getenv("COVERAGE_FILE") is None:
        session.env["COVERAGE_FILE"] = str(tmp_dir / ".coverage")

    session.run("coverage", "erase")
    session.run(
        "coverage",
        "run",
        "-m",
        "pytest",
        "--durations",
        "15",
        "-n",
        os.getenv("PYTEST_XDIST_AUTO_NUM_WORKERS") or "auto",
    )
    session.run("coverage", "combine")
    session.run("coverage", "report")


@nox.session(python=DEFAULT_PYTHON_VERSION, tags=["checks"]{% if package_manager == 'mamba' %}, venv_params=MAMBA_OPTIONS{% endif %})
def lint(session: nox.Session) -> None:
    """Run pre-commit linting."""
{%- if package_manager == 'mamba' or install == 'uv pip' %}
    session.install("--group", "lint")
{%- else %}
    uv_sync("--group", "lint", session=session)
{%- endif %}
    session.run(
        "pre-commit",
        "run",
        "--all-files",
        *session.posargs,
{%- if package_manager == 'uv' %}
        env={"FORCE_PRE_COMMIT_UV_PATCH": "1"},
{%- endif %}
    )


@nox.session(python=DEFAULT_PYTHON_VERSION, tags=["checks"]{% if package_manager == 'mamba' %}, venv_params=MAMBA_OPTIONS{% endif %})
def typecheck(session: nox.Session) -> None:
    """Typecheck Python code."""
    args = mypy_args()
    if args is None:
        session.skip("Type checking is disabled.")
{%- if package_manager == 'mamba' or install == 'uv pip' %}
    session.install(".", "--group", "type")
{%- else %}
    uv_sync(
        "--no-editable",
        "--reinstall-package",
        PROJECT_NAME,
        "--group",
        "type",
        session=session,
    )
{%- endif %}
    session.run("mypy", *args, *(session.posargs or mypy_paths()))

{% if docs %}
@nox.session(python=DEFAULT_PYTHON_VERSION, tags=["checks"]{% if package_manager == 'mamba' %}, venv_params=MAMBA_OPTIONS{% endif %})
def docs(session: nox.Session) -> None:
    """Build the documentation."""
{%- if package_manager == 'mamba' or install == 'uv pip' %}
    session.install("-e", ".", "--group", "docs")
{%- else %}
    uv_sync("--group", "docs", session=session)
{%- endif %}
    session.run(
        "zensical",
        "build",
        "--clean",
        "--strict",
        *session.posargs,
    )


@nox.session(python=DEFAULT_PYTHON_VERSION{% if package_manager == 'mamba' %}, venv_params=MAMBA_OPTIONS{% endif %})
def autodocs(session: nox.Session) -> None:
    """Serve the documentation locally."""
{%- if package_manager == 'mamba' or install == 'uv pip' %}
    session.install("-e", ".", "--group", "docs")
{%- else %}
    uv_sync("--group", "docs", session=session)
{%- endif %}
    session.run(
        "zensical",
        "serve",
        "--open",
        *session.posargs,
    )

{% endif %}{% if package_manager == 'uv' and install == 'uv sync' %}
def uv_sync(*args: str, session: nox.Session) -> None:
    """Run ``uv sync`` to install dependencies."""
    session.run_install(
        "uv",
        "sync",
        "--locked",
        "--no-default-groups",
        *args,
        env={
            "UV_PROJECT_ENVIRONMENT": session.virtualenv.location,
            "UV_PYTHON": session.virtualenv.location,
        },
    )

{% endif %}
if __name__ == "__main__":
    nox.main()
{%- else -%}
"""Development checks using locked Pixi environments."""

from __future__ import annotations

import os
from pathlib import Path

import nox
from scripts.typecheck import mypy_args, mypy_paths

nox.options.sessions = (
    "lint",
    "typecheck",
{% if docs %}    "docs",
{% endif %}{% for minor in range(minimum_python.split('.')[1] | int, 16) %}    "tests-3.{{ minor }}",
{% endfor %})


def run_tests(session: nox.Session, environment: str) -> None:
    """Run focused tests or the complete coverage suite."""
    command = ("pixi", "run", "--locked", "--environment", environment)
    if session.posargs:
        session.run(*command, "pytest", *session.posargs)
        return
    if os.getenv("COVERAGE_FILE") is None:
        session.env["COVERAGE_FILE"] = str(Path(session.create_tmp()) / ".coverage")
    session.run(*command, "coverage", "erase")
    session.run(
        *command,
        "coverage",
        "run",
        "-m",
        "pytest",
        "--durations",
        "15",
        "-n",
        os.getenv("PYTEST_XDIST_AUTO_NUM_WORKERS") or "auto",
    )
    session.run(*command, "coverage", "combine")
    session.run(*command, "coverage", "report")

{% for minor in range(minimum_python.split('.')[1] | int, 16) %}
@nox.session(name="tests-3.{{ minor }}", python=False, tags=["tests"])
def tests_py3{{ minor }}(session: nox.Session) -> None:
    """Test Python 3.{{ minor }}."""
    run_tests(session, "py3{{ minor }}")

{% endfor %}
@nox.session(python=False)
def lint(session: nox.Session) -> None:
    """Run pre-commit."""
    session.run(
        "pixi", "run", "--locked", "pre-commit", "run", "--all-files", *session.posargs
    )


@nox.session(python=False)
def typecheck(session: nox.Session) -> None:
    """Run mypy."""
    args = mypy_args()
    if args is None:
        session.skip("Type checking is disabled.")
    session.run(
        "pixi",
        "run",
        "--locked",
        "mypy",
        *args,
        *(session.posargs or mypy_paths()),
    )
{% if docs %}

@nox.session(python=False)
def docs(session: nox.Session) -> None:
    """Build the documentation."""
    session.run(
        "pixi",
        "run",
        "--locked",
        "zensical",
        "build",
        "--clean",
        "--strict",
        *session.posargs,
    )


@nox.session(python=False)
def autodocs(session: nox.Session) -> None:
    """Serve the documentation."""
    session.run(
        "pixi", "run", "--locked", "zensical", "serve", "--open", *session.posargs
    )
{%- endif %}
{%- endif %}
