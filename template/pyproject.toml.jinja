[build-system]
build-backend = "hatchling.build"
requires = [
  "hatch-vcs>=0.5",
  "hatchling>=1.27",
  "setuptools-scm>=10",
]

[project]
name = "{{ distribution_name }}"
description = "{{ project_description }}"
readme = "README.md"
{% if license != 'none' -%}
license = "{{ license }}"
license-files = [
  "LICENSE",
]
{% endif -%}
maintainers = [
  { name = "{{ user_name }}", email = "{{ user_email }}" },
]
authors = [
  { name = "{{ user_name }}", email = "{{ user_email }}" },
]
requires-python = ">={{ minimum_python }}"
classifiers = [
  "Development Status :: 4 - Beta",
  "Natural Language :: English",
  "Operating System :: OS Independent",
  "Programming Language :: Python",
  "Programming Language :: Python :: 3 :: Only",
{% for minor in range(minimum_python.split('.')[1] | int, 16) %}  "Programming Language :: Python :: 3.{{ minor }}",
{% endfor %}  "Programming Language :: Python :: Implementation :: CPython",
  "Typing :: Typed",
]
dynamic = [
  "version",
]
{%- if cli == 'click' %}
dependencies = [
  "click>=8.3",
]
{%- elif cli == 'typer' %}
dependencies = [
  "typer>=0.20",
]
{%- elif cli == 'cyclopts' %}
dependencies = [
  "cyclopts>=4",
]
{%- else %}
dependencies = []
{%- endif %}
{%- if public_github and docs and github_actions %}
{%- if changelog %}
urls.Changelog = "{{ documentation_url }}/changelog"
{%- endif %}
urls.Documentation = "{{ documentation_url }}/"
{%- elif public_github and changelog %}
urls.Changelog = "{{ repository_url }}/blob/{{ integration_branch }}/CHANGELOG.md"
{%- endif %}
{%- if public_github %}
urls.Homepage = "{{ repository_url }}"
urls.Issues = "{{ repository_url }}/issues"
urls.Repository = "{{ repository_url }}"
{%- endif %}
{% if cli == 'typer' or cli == 'cyclopts' -%}
scripts.{{ distribution_name }} = "{{ import_name }}.cli:app"
{% elif cli -%}
scripts.{{ distribution_name }} = "{{ import_name }}.cli:main"
{% endif %}
[dependency-groups]
dev = [
  { include-group = "lint" },
  { include-group = "release" },
  { include-group = "test" },
  { include-group = "type" },
]
test = [
  "coverage[toml]>=7.11",
  "ipdb>=0.13",
{%- if nox %}
  "{{ 'nox[uv]' if package_manager == 'uv' else 'nox' }}>=2025.2.9",
{%- endif %}
  "pytest>=9",
{%- if pytest_testmon != 'no' %}
  "pytest-testmon>=2.3.0",
{%- endif %}
  "pytest-xdist>=3.8",
]
type = [
  "mypy>=1.19",
  { include-group = "test" },
]
{%- if docs == "zensical" %}
docs = [
  "mkdocstrings-python>=2",
  "zensical>=0.0.56",
]
{%- endif %}
lint = [
  "pre-commit>=4.5",
  "ruff==0.16.4",
]
release = [
{%- if package_manager in ['pixi', 'mamba'] %}
  "build>=1.6",
{%- endif %}
  "packaging>=24.2",
{%- if package_manager in ['pixi', 'mamba'] %}
  "pip>=24",
{%- endif %}
{%- if changelog %}
  "towncrier>=25.8",
{%- endif %}
  "twine>=6.1",
]

[tool.hatch]
version.source = "vcs"
{%- if annotated_tags_only %}
version.raw-options.scm.git.describe_command = [
  "git",
  "describe",
  "--dirty",
  "--long",
  "--abbrev=40",
  "--match",
  "v[0-9]*",
]
{%- endif %}
{%- if package_type == 'namespace' %}
build.targets.wheel.only-include = [
  "{{ package_path.removeprefix('./') }}",
]
{%- if package_layout == 'src' %}
build.targets.wheel.sources = [ "src" ]
{%- endif %}
{%- else %}
build.targets.wheel.packages = [
  "{{ package_path }}",
]
{%- endif %}
{%- if package_manager == 'uv' %}

[tool.uv]
cache-keys = [
  { file = "pyproject.toml" },
  { git = { commit = true, tags = true } },
]
{%- endif %}

{% if package_manager == 'pixi' -%}
[tool.pixi]
workspace.channels = [ "conda-forge" ]
workspace.platforms = [ "linux-64", "osx-64", "osx-arm64", "win-64" ]
pypi-dependencies.{{ distribution_name }} = { path = ".", editable = true }
feature.development.dependencies.python = "3.{{ target_python[3:] }}.*"
{% for minor in range(minimum_python.split('.')[1] | int, 16) %}feature.py3{{ minor }}.dependencies.python = "3.{{ minor }}.*"
{% endfor %}environments.default = { features = [ "development", "dev"{% if docs %}, "docs"{% endif %} ] }
{% for minor in range(minimum_python.split('.')[1] | int, 16) %}environments.py3{{ minor }} = { features = [ "py3{{ minor }}", "test" ] }
{% endfor %}
{% endif -%}
[tool.ruff]
target-version = "{{ target_python }}"
line-length = 88
format.indent-style = "space"
format.quote-style = "double"
format.docstring-code-format = true
lint.select = [
  "B",
  "C4",
  "E",
  "F",
  "I",
  "PIE",
  "RUF",
  "SIM",
  "UP",
  "W",
]
lint.ignore = [
  "COM812", # conflicts with formatter
  "E501",
  "ISC001", # conflicts with formatter
]
lint.per-file-ignores."tests/**" = [
  "S101", # using assert is okay in tests
]
lint.isort.known-first-party = [
  "{{ namespace_name if package_type == 'namespace' else package_name }}",
]
lint.pydocstyle.convention = "numpy"
lint.future-annotations = true

[tool.codespell]
write-changes = true

[tool.pyproject-fmt]

[tool.mypy]
{%- if package_type == 'namespace' %}
mypy_path = "{{ package_root }}"
explicit_package_bases = true
{%- endif %}
python_version = "3.{{ target_python[3:] }}"
check_untyped_defs = true
pretty = true

[tool.pytest]
addopts = [
  "-ra",
  "--tb=short",
  "-n=auto",
{%- if pytest_testmon == 'automatic' %}
  "--testmon",
{%- endif %}
{%- if 'readme' in doctest or 'docs' in doctest %}
  "--doctest-glob",
  "*.md",
{%- endif %}
{%- if 'docstrings' in doctest %}
  "--doctest-modules",
{%- endif %}
  "--showlocals",
]
{%- if package_type == 'namespace' %}
consider_namespace_packages = true
{%- endif %}
filterwarnings = [
  "error",
]
log_level = "INFO"
minversion = "9.0"
strict = true
testpaths = [
{%- if 'docs' in doctest %}
  "docs",
{%- endif %}
{%- if 'docstrings' in doctest %}
  "{{ package_path }}",
{%- endif %}
  "tests",
{%- if 'readme' in doctest %}
  "README.md",
{%- endif %}
]

[tool.coverage]
run.source_pkgs = [
  "{{ import_name }}",
]
run.omit = [
  "__main__.py",
  "setup.py",
]
run.branch = true
run.dynamic_context = "test_function"
run.disable_warnings = [
  "module-not-imported",
  "no-data-collected",
]
run.patch = [
  "subprocess",
]
paths.source = [
  "{{ package_root }}",
  ".nox/**/site-packages",
]
report.fail_under = 90
report.exclude_also = [
  "-> [\"']?(Never|NoReturn)[\"']?:",
  "^\\s*(typing\\.)?assert_never\\b",
  "^\\s*@(abc\\.)?abstractmethod\\b",
  "^\\s*@(typing\\.)?overload\\b",
  "^\\s*if (typing\\.)?TYPE_CHECKING:",
  "^\\s*if False:",
  "^\\s*raise NotImplementedError\\b",
  "^\\s*return NotImplemented\\b",
  "^if __name__ == [\"']__main__[\"']:$",
]
report.skip_covered = true
report.show_missing = true
html.show_contexts = true
html.skip_covered = false
{% if changelog %}
[tool.towncrier]
name = "{{ project_name }}"
directory = "changelog.d"
filename = "CHANGELOG.md"
start_string = "<!-- towncrier release notes start -->\n"
{% if public_github -%}
title_format = "## [{version}]({{ repository_url }}/tree/v{version}) - {project_date}"
issue_format = "[#{issue}]({{ repository_url }}/issues/{issue})"
{% else -%}
title_format = "## {version} - {project_date}"
issue_format = "#{issue}"
{% endif -%}
underlines = [ "", "", "" ]
type = [
  { directory = "security", name = "Security", showcontent = true },
  { directory = "removed", name = "Removed", showcontent = true },
  { directory = "deprecated", name = "Deprecated", showcontent = true },
  { directory = "added", name = "Added", showcontent = true },
  { directory = "changed", name = "Changed", showcontent = true },
  { directory = "fixed", name = "Fixed", showcontent = true },
]
{% endif %}
[tool.project-checks]
typecheck_level = "{{ typecheck_level }}"
typecheck_source_only = {{ 'true' if typecheck_source_only else 'false' }}
require_typecheck = {{ 'true' if require_typecheck else 'false' }}
