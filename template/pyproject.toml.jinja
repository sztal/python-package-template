[build-system]
build-backend = "hatchling.build"
requires = [
  "hatchling>=1.27",
  "uv-dynamic-versioning>=0.14",
]

[project]
name = "{{ distribution_name }}"
description = "{{ project_description }}"
readme = "README.md"
license = "{{ license }}"
license-files = [
  "LICENSE",
]
maintainers = [
  { name = "{{ user_name }}", email = "{{ user_email }}" },
]
authors = [
  { name = "{{ user_name }}", email = "{{ user_email }}" },
]
requires-python = ">=3.13"
classifiers = [
  "Development Status :: 4 - Beta",
  "Natural Language :: English",
  "Operating System :: OS Independent",
  "Programming Language :: Python",
  "Programming Language :: Python :: 3 :: Only",
  "Programming Language :: Python :: 3.13",
  "Programming Language :: Python :: 3.14",
  "Programming Language :: Python :: 3.15",
  "Programming Language :: Python :: Implementation :: CPython",
  "Typing :: Typed",
]
dynamic = [
  "version",
]
{%- if cli == 'click' %}
dependencies = [
  "click>=8.3",
]
{%- elif cli == 'typer' %}
dependencies = [
  "typer>=0.20",
]
{%- elif cli == 'cyclopts' %}
dependencies = [
  "cyclopts>=4",
]
{%- else %}
dependencies = []
{%- endif %}
{%- if docs %}
{%- if changelog %}
urls.Changelog = "{{ documentation_url }}/changelog"
{%- endif %}
urls.Documentation = "{{ documentation_url }}/"
{%- elif changelog %}
urls.Changelog = "{{ repository_url }}/blob/{{ integration_branch }}/CHANGELOG.md"
{%- endif %}
urls.Homepage = "{{ repository_url }}"
urls.Issues = "{{ repository_url }}/issues"
urls.Repository = "{{ repository_url }}"
{% if cli == 'typer' or cli == 'cyclopts' -%}
scripts.{{ distribution_name }} = "{{ import_name }}.cli:app"
{% elif cli -%}
scripts.{{ distribution_name }} = "{{ import_name }}.cli:main"
{% endif %}
[dependency-groups]
dev = [
  { include-group = "lint" },
  { include-group = "release" },
  { include-group = "test" },
  { include-group = "type" },
]
test = [
  "coverage[toml]>=7.11",
  "ipdb>=0.13",
{%- if tasks == "nox" %}
  "nox[uv]>=2025.2.9",
{%- endif %}
  "pytest>=9",
{%- if pytest_testmon != 'no' %}
  "pytest-testmon>=2.3.0",
{%- endif %}
  "pytest-xdist>=3.8",
]
type = [
  "mypy>=1.19",
  { include-group = "test" },
]
{%- if docs == "zensical" %}
docs = [
  "mkdocstrings-python>=2",
  "zensical>=0.0.56",
]
{%- endif %}
lint = [
  "pre-commit>=4.5",
  "ruff==0.16.4",
]
release = [
  "packaging>=24.2",
{%- if changelog %}
  "towncrier>=25.8",
{%- endif %}
  "twine>=6.1",
]

[tool.hatch]
version.source = "uv-dynamic-versioning"
{%- if package_type == 'namespace' %}
build.targets.wheel.only-include = [
  "{{ package_path.removeprefix('./') }}",
]
{%- if package_layout == 'src' %}
build.targets.wheel.sources = [ "src" ]
{%- endif %}
{%- else %}
build.targets.wheel.packages = [
  "{{ package_path }}",
]
{%- endif %}

[tool.ruff]
target-version = "{{ target_python }}"
line-length = 88
format.indent-style = "space"
format.quote-style = "double"
format.docstring-code-format = true
lint.select = [
  "B",
  "C4",
  "E",
  "F",
  "I",
  "PIE",
  "RUF",
  "SIM",
  "UP",
  "W",
]
lint.ignore = [
  "COM812", # conflicts with formatter
  "E501",
  "ISC001", # conflicts with formatter
]
lint.per-file-ignores."tests/**" = [
  "S101", # using assert is okay in tests
]
lint.isort.known-first-party = [
  "{{ namespace_name if package_type == 'namespace' else package_name }}",
]
lint.pydocstyle.convention = "numpy"
lint.future-annotations = true

[tool.codespell]
write-changes = true

[tool.pyproject-fmt]

[tool.mypy]
{%- if package_type == 'namespace' %}
mypy_path = "{{ package_root }}"
explicit_package_bases = true
{%- endif %}
python_version = "3.{{ target_python[3:] }}"
warn_unreachable = true
enable_error_code = [
  "ignore-without-code",
  "redundant-expr",
  "truthy-bool",
]
strict = true
pretty = true

[tool.pytest]
addopts = [
  "-ra",
  "-v",
  "--tb=short",
{%- if pytest_testmon == 'automatic' %}
  "--testmon",
{%- endif %}
{%- if 'readme' in doctest or 'docs' in doctest %}
  "--doctest-glob",
  "*.md",
{%- endif %}
{%- if 'docstrings' in doctest %}
  "--doctest-modules",
{%- endif %}
  "--showlocals",
]
filterwarnings = [
  "error",
]
log_level = "INFO"
minversion = "9.0"
strict = true
testpaths = [
{%- if 'docs' in doctest %}
  "docs",
{%- endif %}
{%- if 'docstrings' in doctest %}
  "{{ package_path }}",
{%- endif %}
  "tests",
{%- if 'readme' in doctest %}
  "README.md",
{%- endif %}
]

[tool.coverage]
run.source_pkgs = [
  "{{ import_name }}",
]
run.omit = [
  "__main__.py",
  "setup.py",
]
run.branch = true
run.dynamic_context = "test_function"
run.disable_warnings = [
  "module-not-imported",
  "no-data-collected",
]
run.patch = [
  "subprocess",
]
paths.source = [
  "{{ package_root }}",
  ".nox/**/site-packages",
]
report.fail_under = 90
report.exclude_also = [
  "-> [\"']?(Never|NoReturn)[\"']?:",
  "^\\s*(typing\\.)?assert_never\\b",
  "^\\s*@(abc\\.)?abstractmethod\\b",
  "^\\s*@(typing\\.)?overload\\b",
  "^\\s*if (typing\\.)?TYPE_CHECKING:",
  "^\\s*if False:",
  "^\\s*raise NotImplementedError\\b",
  "^\\s*return NotImplemented\\b",
  "^if __name__ == [\"']__main__[\"']:$",
]
report.skip_covered = true
report.show_missing = true
html.show_contexts = true
html.skip_covered = false

{% if changelog -%}
[tool.towncrier]
name = "{{ project_name }}"
directory = "changelog.d"
filename = "CHANGELOG.md"
start_string = "<!-- towncrier release notes start -->\n"
title_format = "## [{version}]({{ repository_url }}/tree/v{version}) - {project_date}"
issue_format = "[#{issue}]({{ repository_url }}/issues/{issue})"
underlines = [ "", "", "" ]
type = [
  { directory = "security", name = "Security", showcontent = true },
  { directory = "removed", name = "Removed", showcontent = true },
  { directory = "deprecated", name = "Deprecated", showcontent = true },
  { directory = "added", name = "Added", showcontent = true },
  { directory = "changed", name = "Changed", showcontent = true },
  { directory = "fixed", name = "Fixed", showcontent = true },
]
{% endif -%}
